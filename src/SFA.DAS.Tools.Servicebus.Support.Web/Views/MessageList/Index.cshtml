@model MessageListViewModel

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.18.1/bootstrap-table.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.11/lodash.min.js"></script>

    <script type="text/javascript">

        function operateFormatter(value, row, index) {
            var state = getCurrentState();
            var query = $.param({
                id: row.id,
                returnOffset: state.returnOffset,
                returnLimit: state.returnLimit,
                returnSearch: state.returnSearch,
                returnSort: state.returnSort,
                returnOrder: state.returnOrder,
                returnGetQuantity: state.returnGetQuantity
            });

            return '<a class="detail" href=' + ($('#baseUrl').val() + "/?" + query) + ' title ="Detail">Detail</a>';
        };

        var $table = $("#table");
        var selections = [];

        function getCurrentState() {
            var options = $table.bootstrapTable('getOptions');
            var searchInput = $('.search input').val();

            return {
                returnOffset: options.pageSize * (options.pageNumber - 1),
                returnLimit: options.pageSize,
                returnSearch: searchInput || options.searchText || '',
                returnSort: options.sortName || '',
                returnOrder: options.sortOrder || '',
                returnGetQuantity: $('#getQty :selected').val()
            };
        }

        function applyStateToForms() {
            var state = getCurrentState();

            $('.list-state-field').each(function() {
                var fieldName = $(this).data('field');
                $(this).val(state[fieldName]);
            });
        }

        function responseHandler(res) {
            $.each(res.rows,
                function (i, row) {
                    row.state = $.inArray(row.id, selections) !== -1;
                });

            return res;
        }

        $(function () {
            $table.on('check.bs.table check-all.bs.table uncheck.bs.table uncheck-all.bs.table',
                function (e, rowsAfter, rowsBefore) {
                    var rows = rowsAfter;

                    if (e.type === 'uncheck-all') {
                        rows = rowsBefore;
                    }

                    var ids = $.map(!$.isArray(rows) ? [rows] : rows,
                        function (row) {
                            return row.id;
                        });

                    var func = $.inArray(e.type, ['check', 'check-all']) > -1 ? 'union' : 'difference';
                    selections = window._[func](selections, ids);
                });

            $table.on('search.bs.table',
                function () {
                    selections = [];
                    console.log("selection cleared");
                });
        });

        $("#btnDeleteMessages").click(function () {

            $('#deleteConfirmationModal').modal()
        });

        $('#btnDeleteMessagesModalConfirmation').click(function () {

            $('#deleteConfirmationModal').modal('hide');
            displayBusyIndicator();
            applyStateToForms();
            $('#deleteMessagesIdsField').val(selections);
            $('#deleteMessagesForm').submit();
        })

        function releaseSelectedMessages() {
            displayBusyIndicator();
            applyStateToForms();
            $('#releaseSelectedMessagesIdsField').val(selections);
            $('#releaseSelectedMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#releaseSelectedMessagesForm').submit();
        }

        function replayMessages() {
            displayBusyIndicator();
            applyStateToForms();
            $('#replayMessagesIdsField').val(selections);
            $('#replayMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#replayMessagesForm').submit();
        }

        function openReplayToDestination() {
            $('#replayDestinationError').text('');
            $('#replayDestinationNameInput').val('');
            $('#replayDestinationConfirmationInput').val('');
            $('input[name="replayDestinationKindChoice"]').prop('checked', false);
            $('#replayToDestinationModal').modal();
        }

        $('#btnReplayToDestinationConfirmation').click(function () {
            var destination = $.trim($('#replayDestinationNameInput').val());
            var confirmation = $.trim($('#replayDestinationConfirmationInput').val());
            var kind = $('input[name="replayDestinationKindChoice"]:checked').val();
            var sourceQueue = '@Model.QueueInfo.Name';

            if (!selections.length) {
                $('#replayDestinationError').text('Select at least one message.');
                return;
            }

            if (!kind || !destination || destination.toLowerCase() !== confirmation.toLowerCase()) {
                $('#replayDestinationError').text('Choose a queue or a topic, enter the destination, and type the same name again.');
                return;
            }

            if (destination.toLowerCase() === sourceQueue.toLowerCase()) {
                $('#replayDestinationError').text('That is the queue these messages were taken from. Use Release selected to put them back there.');
                return;
            }

            $('#replayToDestinationModal').modal('hide');
            displayBusyIndicator();
            applyStateToForms();
            $('#replayToDestinationIdsField').val(selections);
            $('#replayToDestinationQueueNameField').val(sourceQueue);
            $('#replayToDestinationNameField').val(destination);
            $('#replayToDestinationKindField').val(kind);
            $('#replayToDestinationConfirmationField').val(confirmation);
            $('#replayToDestinationConfirmedField').val('true');
            $('#replayToDestinationForm').submit();
        });

        function getQueueMessages() {
            displayBusyIndicator();
            applyStateToForms();
            var qtyValue = $('#getQty :selected').val();
            $('#receiveMessagesQtyField').val(qtyValue);
            $('#receiveMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#receiveMessagesForm').submit();
        }

    </script>
}

@section Styles
{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.18.1/bootstrap-table.min.css" />
}

<div>

    <input id="baseUrl" type="hidden" value="@(Url.Action("Index", "MessageDetails"))" />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <p class="govuk-body">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <h3 class="govuk-heading-l">Queue - @Model.QueueInfo.Name</h3>

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
                Investigating
            </dt>
            <dd class="govuk-summary-list__value">
                @Model.Count
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
                On the queue
            </dt>
            <dd class="govuk-summary-list__value">
                @Model.QueueInfo.MessageCount
            </dd>
        </div>
    </dl>

    <div>
        <fieldset>
            <legend>Message actions</legend>

            <select class="govuk-select" name="getQty" id="getQty">
                @if (Model.ListState.ReturnGetQuantity == 250)
                {
                    <option value="250" selected>250</option>
                }
                else
                {
                    <option value="250">250</option>
                }
                @if (Model.ListState.ReturnGetQuantity == 500)
                {
                    <option value="500" selected>500</option>
                }
                else
                {
                    <option value="500">500</option>
                }
                @if (Model.ListState.ReturnGetQuantity == 1000)
                {
                    <option value="1000" selected>1000</option>
                }
                else
                {
                    <option value="1000">1000</option>
                }
            </select>
            <a class="govuk-link" id="btnReceiveMessages" href="#" onclick="getQueueMessages()" title="Get any further messages that may be on the queue">Get more</a> |
            <form method="post" id="receiveMessagesForm" asp-action="ReceiveMessagesFromQueue" hidden="hidden">
                <input type="hidden" name="getQuantity" id="receiveMessagesQtyField" />
                <input type="hidden" name="queueName" id="receiveMessagesQueueNameField" />
                <input class="list-state-field" data-field="returnOffset" type="hidden" name="returnOffset" />
                <input class="list-state-field" data-field="returnLimit" type="hidden" name="returnLimit" />
                <input class="list-state-field" data-field="returnSearch" type="hidden" name="returnSearch" />
                <input class="list-state-field" data-field="returnSort" type="hidden" name="returnSort" />
                <input class="list-state-field" data-field="returnOrder" type="hidden" name="returnOrder" />
                <input class="list-state-field" data-field="returnGetQuantity" type="hidden" name="returnGetQuantity" />
            </form>

            <a class="govuk-link" id="btnReplayMessages" href="#" onclick="replayMessages()" title="Move selected messages back to the processing queue">Move selected to processing queue</a> |
            <a class="govuk-link" id="btnReplayToDestination" href="#" onclick="openReplayToDestination()" title="Send selected messages to a queue or topic you name">Move selected to another queue or topic</a> |
            <form method="post" id="replayMessagesForm" asp-action="ReplayMessages" hidden="hidden">
                <input type="hidden" name="ids" id="replayMessagesIdsField" />
                <input type="hidden" name="queueName" id="replayMessagesQueueNameField" />
                <input class="list-state-field" data-field="returnOffset" type="hidden" name="returnOffset" />
                <input class="list-state-field" data-field="returnLimit" type="hidden" name="returnLimit" />
                <input class="list-state-field" data-field="returnSearch" type="hidden" name="returnSearch" />
                <input class="list-state-field" data-field="returnSort" type="hidden" name="returnSort" />
                <input class="list-state-field" data-field="returnOrder" type="hidden" name="returnOrder" />
                <input class="list-state-field" data-field="returnGetQuantity" type="hidden" name="returnGetQuantity" />
            </form>

            <form method="post" id="replayToDestinationForm" asp-action="ReplayMessagesToDestination" hidden="hidden">
                <input type="hidden" name="ids" id="replayToDestinationIdsField" />
                <input type="hidden" name="queueName" id="replayToDestinationQueueNameField" />
                <input type="hidden" name="destinationName" id="replayToDestinationNameField" />
                <input type="hidden" name="destinationKind" id="replayToDestinationKindField" />
                <input type="hidden" name="confirmationName" id="replayToDestinationConfirmationField" />
                <input type="hidden" name="confirmed" id="replayToDestinationConfirmedField" value="false" />
                <input class="list-state-field" data-field="returnOffset" type="hidden" name="returnOffset" />
                <input class="list-state-field" data-field="returnLimit" type="hidden" name="returnLimit" />
                <input class="list-state-field" data-field="returnSearch" type="hidden" name="returnSearch" />
                <input class="list-state-field" data-field="returnSort" type="hidden" name="returnSort" />
                <input class="list-state-field" data-field="returnOrder" type="hidden" name="returnOrder" />
                <input class="list-state-field" data-field="returnGetQuantity" type="hidden" name="returnGetQuantity" />
            </form>

            <a class="govuk-link" id="btnDeleteMessages" href="#" title="Delete the selected messages permanently">Delete selected</a> |
            <form method="post" id="deleteMessagesForm" asp-action="DeleteMessages" hidden="hidden">
                <input type="hidden" name="ids" id="deleteMessagesIdsField" />
                <input class="list-state-field" data-field="returnOffset" type="hidden" name="returnOffset" />
                <input class="list-state-field" data-field="returnLimit" type="hidden" name="returnLimit" />
                <input class="list-state-field" data-field="returnSearch" type="hidden" name="returnSearch" />
                <input class="list-state-field" data-field="returnSort" type="hidden" name="returnSort" />
                <input class="list-state-field" data-field="returnOrder" type="hidden" name="returnOrder" />
                <input class="list-state-field" data-field="returnGetQuantity" type="hidden" name="returnGetQuantity" />
            </form>

            <a class="govuk-link" id="btnReleaseSelectedMessages" href="#" onclick="releaseSelectedMessages()" title="Release selected messages back to the ServiceBus Queue they came from">Release selected</a> |
            <form method="post" id="releaseSelectedMessagesForm" asp-action="ReleaseSelectedMessages" hidden="hidden">
                <input type="hidden" name="ids" id="releaseSelectedMessagesIdsField" />
                <input type="hidden" name="queueName" id="releaseSelectedMessagesQueueNameField" />
                <input class="list-state-field" data-field="returnOffset" type="hidden" name="returnOffset" />
                <input class="list-state-field" data-field="returnLimit" type="hidden" name="returnLimit" />
                <input class="list-state-field" data-field="returnSearch" type="hidden" name="returnSearch" />
                <input class="list-state-field" data-field="returnSort" type="hidden" name="returnSort" />
                <input class="list-state-field" data-field="returnOrder" type="hidden" name="returnOrder" />
                <input class="list-state-field" data-field="returnGetQuantity" type="hidden" name="returnGetQuantity" />
            </form>

            <a class="govuk-link" asp-controller="MessageList" asp-action="ReleaseAllMessages" asp-route-queue="@Model.QueueInfo.Name" onclick="displayBusyIndicator()" title="Release messages back to the servicebus queue they came from">Release all</a>
        </fieldset>
    </div>

    <table id="table"
           class="govuk-table"
           data-toggle="table"
           data-pagination="true"
           data-search="true"
           data-click-to-select="true"
           data-sortable="true"
           data-side-pagination="server"
           data-page-size="@Model.ListState.ReturnLimit"
           data-page-number="@((Model.ListState.ReturnOffset / Model.ListState.ReturnLimit) + 1)"
           data-search-text="@Model.ListState.ReturnSearch"
           data-sort-name="@Model.ListState.ReturnSort"
           data-sort-order="@Model.ListState.ReturnOrder"
           data-url="@Url.Action("Index", "Messages")"
           style="table-layout: fixed"
           data-response-handler="responseHandler">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col"
                    class="col-wrap"
                    data-field="id"
                    data-visible="false">
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-field="state"
                    data-checkbox="true"
                    data-width="5"
                    data-width-unit="%">
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="originatingEndpoint"
                    data-width="10"
                    data-width-unit="%">
                    Originating endpoint
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="processingEndpoint"
                    data-width="10"
                    data-width-unit="%">
                    Processing endpoint
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-field="body"
                    data-width="25"
                    data-width-unit="%">
                    Body
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-field="exception"
                    data-width="25"
                    data-width-unit="%">
                    Exception
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="exceptionType"
                    data-width="10"
                    data-width-unit="%">
                    Exception type
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-width="10"
                    data-width-unit="%"
                    data-formatter="operateFormatter">
                    Actions
                </th>
            </tr>
        </thead>
    </table>

    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title govuk-heading-m">Delete messages</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="govuk-body">Deleting a message will permanently remove it from a queue. This action is not reversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="govuk-button" data-module="govuk-button" id="btnDeleteMessagesModalConfirmation">Confirm</button>
                    <button type="button" class="govuk-button govuk-button--secondary" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="replayToDestinationModal" tabindex="-1" role="dialog" aria-labelledby="replayToDestinationTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title govuk-heading-m" id="replayToDestinationTitle">Send to another queue or topic</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="govuk-body">This does not use the processing queue. The selected messages are sent to the name you type, then removed from investigating.</p>
                    <p class="govuk-body">A queue send goes only to that queue. A topic send publishes to that topic, so every matching subscription can receive it.</p>
                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend">Destination</legend>
                            <div class="govuk-radios">
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="replayDestinationKindQueue" name="replayDestinationKindChoice" type="radio" value="Queue">
                                    <label class="govuk-label govuk-radios__label" for="replayDestinationKindQueue">Queue</label>
                                </div>
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="replayDestinationKindTopic" name="replayDestinationKindChoice" type="radio" value="Topic">
                                    <label class="govuk-label govuk-radios__label" for="replayDestinationKindTopic">Topic</label>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="replayDestinationNameInput">Name</label>
                        <input class="govuk-input" id="replayDestinationNameInput" type="text" autocomplete="off">
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="replayDestinationConfirmationInput">Type the name again</label>
                        <input class="govuk-input" id="replayDestinationConfirmationInput" type="text" autocomplete="off">
                    </div>
                    <p class="govuk-error-message" id="replayDestinationError"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" id="btnReplayToDestinationConfirmation">Send</button>
                    <button type="button" class="govuk-button govuk-button--secondary" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
